# Your machine. Copy to apps/web/.env.development (bootstrap does this); used by `pnpm dev:admin`.
# The admin app authenticates users with POST /api/v1/auth/login-password; it holds no API key.
VITE_API_BASE_URL=http://localhost:8000
VITE_DEFAULT_CURRENCY=USD
# Open the portal at http://<store>.localhost:5173; plain http://localhost:5173 uses VITE_DEFAULT_TENANT.
VITE_TENANT_BASE_DOMAINS=localhost
VITE_DEFAULT_TENANT=demo
# Lists the demo accounts from packages/catalog/demo-users.json on the login page.
# Honored only by `vite dev`; builds never include the demo file.
VITE_SHOW_DEMO_ACCOUNTS=false
# Optional: makes the Super Admin demo card sign in with one click.
# Use the same values as ADMIN_USERNAME / ADMIN_PASSWORD in apps/api/.env.development.
VITE_DEMO_ADMIN_USERNAME=admin
VITE_DEMO_ADMIN_PASSWORD=
