# Shared dev server build (`pnpm build:admin:dev`). Committed: Vite inlines these into the bundle,
# so this file must never hold a secret.
# Each store opens its portal at https://<store>.dev.qios.ae and talks to its own API host.
VITE_API_BASE_URL=https://{tenant}.dev.qios.ae
VITE_TENANT_BASE_DOMAINS=dev.qios.ae
VITE_DEFAULT_CURRENCY=USD
VITE_SHOW_DEMO_ACCOUNTS=false
