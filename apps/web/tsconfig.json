{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@reach/*": ["../../plugins/reach/frontend/*"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react-router-dom": ["./node_modules/react-router-dom/dist/index.d.ts"],
      "@ai-pos/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@ai-pos/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
