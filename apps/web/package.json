{
  "name": "@ai-pos/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build --mode production",
    "build:dev": "tsc -p tsconfig.json --noEmit && vite build --mode dev",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "@ai-pos/catalog": "workspace:*",
    "@ai-pos/design-tokens": "workspace:*",
    "@ai-pos/receipt": "workspace:*",
    "@ai-pos/shared-types": "workspace:*",
    "@ai-pos/ui": "workspace:*",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5"
  }
}
