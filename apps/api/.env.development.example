# Your machine. Copy to apps/api/.env.development (bootstrap does this and generates the secrets).
# Selected by APP_ENV=development, the default for `pnpm dev:backend`, migrate and seed.
# URL-encode special characters in the password (for example "@" becomes %40).
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/ai_pos

# Multi-tenant mode (optional locally). Create the control DB and adopt this database first:
#   python -m app.tenancy.cli init
#   python -m app.tenancy.cli adopt demo --name "Demo" --database ai_pos
# CONTROL_DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/qios_control
# Requests that name no store (plain http://localhost) use this tenant:
# DEFAULT_TENANT=demo
# Store domains: demo.localhost here (the POS dev build uses the same base). qios.ae keeps registers
# activated against demo.qios.ae working.
TENANT_BASE_DOMAINS=localhost,qios.ae
TENANT_PUBLIC_URL_TEMPLATE=http://{tenant}.localhost:5173

# Self-service signup at http://localhost:5173/signup (needs CONTROL_DATABASE_URL). With SIGNUP_OTP_CHANNEL=log
# the one-time code is written to the API log and shown on the signup screen.
# SIGNUP_ENABLED=true
# SIGNUP_OTP_CHANNEL=log
# SIGNUP_OTP_MINUTES=10
# SIGNUP_MAX_PER_HOUR=5

# JWT_SECRET signs access tokens (HS256). Rotating it signs every user out.
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# PIN_SALT is a server-side pepper mixed into every POS PIN hash. Changing it invalidates all PINs.
PIN_SALT=change-me-pin-pepper-16+
# ENCRYPTION_SECRET derives the key for IMEI/serial ciphertext. Changing it makes stored identifiers unreadable.
ENCRYPTION_SECRET=change-me-to-a-different-random-string-32
# API_KEY is the legacy shared register credential; activated registers use their own device token.
API_KEY=change-me-api-key

API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:1420,tauri://localhost,http://tauri.localhost
ACCESS_TOKEN_EXPIRE_MINUTES=30

# POS-company console (apps/super-admin, multi-tenant mode). Its own secret, never the same as JWT_SECRET.
# Create staff with: python -m app.tenancy.cli create-operator --email you@qios.ae --name "You" --role ADMIN
# CONSOLE_JWT_SECRET=
# CONSOLE_ORIGINS=http://localhost:5174
# SUPPORT_EMAIL=support@qios.ae
SYNC_MAX_BATCH_SIZE=100
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Root Super Admin created by `pnpm --filter @ai-pos/api seed` when the username does not exist yet.
# The seed never overwrites an existing user's credentials.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Super Admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_PIN=135790

# Integrated card terminals and buy-now-pay-later. Every provider runs on its simulator until its
# credentials are set, so demos and practice mode work without a merchant account.
# CARD_TERMINAL_PROVIDER=simulator        # simulator | ngenius | geidea
# BNPL_PROVIDERS=simulator                # comma-separated: simulator,tabby,tamara
# INTEGRATION_WEBHOOK_SECRET=             # HMAC secret for X-Signature on provider webhooks
# NGENIUS_API_KEY=
# NGENIUS_OUTLET_REF=
# NGENIUS_BASE_URL=https://api-gateway.sandbox.ngenius-payments.com
# GEIDEA_PUBLIC_KEY=
# GEIDEA_API_PASSWORD=
# TABBY_SECRET_KEY=
# TABBY_MERCHANT_CODE=
# TAMARA_API_TOKEN=
# TAMARA_NOTIFICATION_TOKEN=
# TAMARA_BASE_URL=https://api-sandbox.tamara.co
