# Shared dev server: stores at https://{tenant}.dev.qios.ae. Copy to apps/api/.env.dev on that server.
# Selected by APP_ENV=dev (`pnpm --filter @ai-pos/api start:dev`, `migrate:dev`).
# Generate the secrets with `node scripts/generate-secrets.mjs --env dev`; never reuse production values.

# Template for the tenant databases created by `python -m app.tenancy.cli create`; DATABASE_URL is its server.
DATABASE_URL=postgresql+psycopg://ai_pos:change-me@db-dev.internal:5432/postgres
CONTROL_DATABASE_URL=postgresql+psycopg://ai_pos:change-me@db-dev.internal:5432/qios_control
# TENANT_DATABASE_URL_TEMPLATE=postgresql+psycopg://ai_pos:change-me@db-dev.internal:5432/{database}
TENANT_BASE_DOMAINS=dev.qios.ae
TENANT_PUBLIC_URL_TEMPLATE=https://{tenant}.dev.qios.ae

# Self-service signup at https://dev.qios.ae/signup. With SIGNUP_OTP_CHANNEL=log the code is written to the API log
# and shown on the signup screen; whatsapp, sms and email use the WHATSAPP_*, SMS_* and SMTP_* settings.
SIGNUP_ENABLED=true
SIGNUP_OTP_CHANNEL=log
SIGNUP_OTP_MINUTES=10
SIGNUP_MAX_PER_HOUR=5

JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
PIN_SALT=change-me-pin-pepper-16+
ENCRYPTION_SECRET=change-me-to-a-different-random-string-32
API_KEY=change-me-api-key
# Registers authenticate with their own activated device token only.
ALLOW_SHARED_API_KEY=false

API_HOST=127.0.0.1
API_PORT=8000
PUBLIC_BASE_URL=https://api.dev.qios.ae
# Store portals (https://<store>.dev.qios.ae) are allowed from TENANT_BASE_DOMAINS; list the POS shell here.
CORS_ORIGINS=tauri://localhost,http://tauri.localhost
ACCESS_TOKEN_EXPIRE_MINUTES=30
# POS-company console at https://console.dev.qios.ae. Set its own secret (never JWT_SECRET's value).
# CONSOLE_JWT_SECRET=
# CONSOLE_ORIGINS=https://console.dev.qios.ae
# SUPPORT_EMAIL=support@qios.ae
SYNC_MAX_BATCH_SIZE=100
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Super Admin seeded into each new tenant database by the tenancy CLI.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Super Admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_PIN=135790

# Integrated card terminals and buy-now-pay-later; simulators until credentials are set.
# CARD_TERMINAL_PROVIDER=simulator        # simulator | ngenius | geidea
# BNPL_PROVIDERS=simulator,tabby,tamara
# INTEGRATION_WEBHOOK_SECRET=
# NGENIUS_API_KEY=
# NGENIUS_OUTLET_REF=
# GEIDEA_PUBLIC_KEY=
# GEIDEA_API_PASSWORD=
# TABBY_SECRET_KEY=
# TABBY_MERCHANT_CODE=
# TAMARA_API_TOKEN=
# TAMARA_NOTIFICATION_TOKEN=
