# "AI POS Dev" installer for the shared dev server (`pnpm build:pos:dev`). Committed: every value is baked
# into the installer, so this file must never hold a secret.

# Read by src-tauri/build.rs at compile time. A cashier enters "client1" and the register activates against
# https://client1.dev.qios.ae. Setting TENANT_URL_TEMPLATE on a PC still overrides it (LAN testing).
TENANT_URL_TEMPLATE=https://{tenant}.dev.qios.ae
TENANT_BASE_DOMAIN=dev.qios.ae

# The screens. The installed app reaches the API through the Rust shell with its activated token; the
# VITE_API_BASE_URL / VITE_DEVICE_ID values are required placeholders for the browser-preview client.
VITE_API_BASE_URL=https://dev.qios.ae
VITE_API_KEY=
VITE_DEVICE_ID=unactivated
VITE_TENANT_BASE_DOMAIN=dev.qios.ae
VITE_SYNC_INTERVAL_MS=15000
VITE_SHOW_DEMO_ACCOUNTS=false
