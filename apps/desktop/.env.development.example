# Your machine. Copy to apps/desktop/.env.development (bootstrap does this); used by `pnpm dev:pos`.
# Only debug builds read this file at runtime; installers are built from .env.dev / .env.production.
#
# Registers are configured by first-run activation: the cashier enters the store subdomain and a one-time
# key from Admin portal > Registers. The tenant, store, register, and device token are stored encrypted
# (Windows DPAPI) in the app data folder; every request sends X-Tenant-Domain and X-Terminal-Token.

# Where activation calls go; the tenant travels in the X-Tenant-Domain header (demo.localhost).
TENANT_URL_TEMPLATE=http://localhost:8000
TENANT_BASE_DOMAIN=localhost

# Legacy developer setup that skips activation. Set POS_DEV_ENV_CONFIG=true to use these values instead.
# POS_DEV_ENV_CONFIG=true
API_BASE_URL=http://localhost:8000
API_KEY=change-me-api-key
DEVICE_ID=desktop-dev-01
# TENANT_DOMAIN=demo.localhost
# The branch this terminal sells from (stores.id). Its catalog shows that branch's stock only.
STORE_ID=00000000-0000-4000-8000-000000000001

# Browser preview at http://localhost:1420 (not the Tauri shell). Vite inlines these into the bundle.
VITE_STORE_ID=00000000-0000-4000-8000-000000000001
VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=change-me-api-key
VITE_DEVICE_ID=desktop-dev-01
# Tenant the browser preview talks to (sent as X-Tenant-Domain).
# VITE_TENANT_DOMAIN=demo.localhost
VITE_TENANT_BASE_DOMAIN=localhost
VITE_SYNC_INTERVAL_MS=15000
# Lists demo cashiers on the unlock screen. Honored only by `vite dev`, never in a build.
VITE_SHOW_DEMO_ACCOUNTS=false
