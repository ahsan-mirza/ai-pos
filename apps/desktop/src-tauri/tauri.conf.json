{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AxizPOS",
  "version": "0.1.1",
  "identifier": "com.aipos.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AxizPOS",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8000 http://127.0.0.1:8000 http://130.210.53.214 ipc: http://ipc.localhost; img-src 'self' data: http://asset.localhost asset: http://localhost:8000 http://127.0.0.1:8000 http://130.210.53.214; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/media/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AxizPOS",
    "homepage": "https://axizpos.com",
    "copyright": "Copyright © 2026 AxizPOS",
    "category": "Business",
    "shortDescription": "AxizPOS",
    "longDescription": "AxizPOS point of sale for Windows. A connection file is opened only after the person chooses it.",
    "fileAssociations": [
      {
        "ext": ["posdemo"],
        "name": "AxizPOS Demo Connection",
        "description": "AxizPOS connection file",
        "mimeType": "application/vnd.axizpos.posdemo",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": true,
      "signCommand": {
        "cmd": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "sign-pos.ps1", "%1"]
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "AxizPOS",
        "installerHooks": "../build/installer.nsh"
      },
      "wix": {
        "upgradeCode": "006f8044-e035-5dd5-8f9e-488ecfd6a942"
      }
    }
  }
}
