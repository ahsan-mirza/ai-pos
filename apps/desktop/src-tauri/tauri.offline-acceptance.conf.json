{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AxizPOS Offline Acceptance",
  "identifier": "com.axizpos.offline.acceptance",
  "build": {
    "beforeDevCommand": "pnpm exec vite --mode offline-acceptance --port 1422 --strictPort",
    "beforeBuildCommand": "pnpm build:offline-acceptance",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AxizPOS Offline Acceptance",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:18084 ipc: http://ipc.localhost; img-src 'self' data: http://asset.localhost asset: http://127.0.0.1:18084; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:"
    }
  },
  "bundle": {
    "active": false,
    "fileAssociations": [],
    "windows": {
      "signCommand": null,
      "nsis": {
        "installerHooks": null
      }
    }
  }
}
