{
  "name": "@ai-pos/desktop",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build --mode production",
    "build:dev": "tsc -p tsconfig.json --noEmit && vite build --mode dev",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sync-version": "node ../../scripts/sync-pos-version.mjs",
    "tauri:dev": "pnpm sync-version && tauri dev",
    "tauri:build": "pnpm sync-version && cross-env POS_ENV=production tauri build",
    "build:win": "pnpm sync-version && cross-env POS_ENV=production tauri build --bundles nsis --target x86_64-pc-windows-msvc && node ../../scripts/stage-pos-setup.mjs",
    "tauri:build:dev": "pnpm sync-version && cross-env POS_ENV=dev tauri build --config src-tauri/tauri.dev.conf.json"
  },
  "dependencies": {
    "@ai-pos/catalog": "workspace:*",
    "@ai-pos/design-tokens": "workspace:*",
    "@ai-pos/receipt": "workspace:*",
    "@ai-pos/shared-types": "workspace:*",
    "@ai-pos/ui": "workspace:*",
    "@tauri-apps/api": "^2.5.0",
    "lucide-react": "^0.511.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "^9.27.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
