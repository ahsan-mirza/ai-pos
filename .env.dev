# Shared dev server builds (`pnpm build:admin:dev`, `pnpm build:pos:dev`, `pnpm build:console:dev`).
# Committed: Vite and the register installer inline these, so this file must never hold a secret.
# API secrets for this environment live in .env.dev.local (gitignored) or on the dev server as .env.dev.

VITE_API_BASE_URL=https://{tenant}.dev.qios.ae
VITE_POS_API_BASE_URL=https://dev.qios.ae
VITE_TENANT_BASE_DOMAINS=dev.qios.ae
VITE_TENANT_BASE_DOMAIN=dev.qios.ae
VITE_DEFAULT_CURRENCY=USD
VITE_SHOW_DEMO_ACCOUNTS=false
VITE_API_KEY=
VITE_DEVICE_ID=unactivated
VITE_SYNC_INTERVAL_MS=15000
VITE_CONSOLE_API_BASE_URL=https://api.dev.qios.ae

TENANT_URL_TEMPLATE=https://{tenant}.dev.qios.ae
TENANT_BASE_DOMAIN=dev.qios.ae
