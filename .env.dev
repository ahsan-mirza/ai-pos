# Shared dev server builds (`pnpm build:admin:dev`, `pnpm build:pos:dev`, `pnpm build:console:dev`).
# Committed: Vite and the register installer inline these, so this file must never hold a secret.
# API secrets for this environment live in .env.dev.local (gitignored) or on the dev server as .env.dev.

VITE_API_BASE_URL=https://{tenant}.dev.axizpos.com
VITE_POS_API_BASE_URL=https://dev.axizpos.com
VITE_TENANT_BASE_DOMAINS=dev.axizpos.com
VITE_TENANT_BASE_DOMAIN=dev.axizpos.com
VITE_DEFAULT_CURRENCY=USD
VITE_SHOW_DEMO_ACCOUNTS=false
VITE_API_KEY=
VITE_DEVICE_ID=unactivated
VITE_SYNC_INTERVAL_MS=15000
VITE_CONSOLE_API_BASE_URL=https://api.dev.axizpos.com

TENANT_URL_TEMPLATE=https://{tenant}.dev.axizpos.com
TENANT_BASE_DOMAIN=dev.axizpos.com

# Outbound email via Spacemail. SSL on port 465. Put the mailbox password in .env.dev.local, not in this file.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USERNAME=info@axizpos.com
SMTP_PASSWORD=Ahsan@6684*
SMTP_FROM=info@axizpos.com
SMTP_STARTTLS=false
