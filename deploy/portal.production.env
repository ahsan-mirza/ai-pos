# Public values for CI portal and register builds. No secrets.
# Used only when the gitignored .env.production is not on the build machine.
# The register calls the VM by public IP until a domain exists.

VITE_API_BASE_URL=same-origin
VITE_POS_API_BASE_URL=http://130.210.53.214
VITE_TENANT_BASE_DOMAINS=axizpos.com
VITE_TENANT_BASE_DOMAIN=axizpos.com
VITE_DEFAULT_CURRENCY=USD
VITE_SHOW_DEMO_ACCOUNTS=false
VITE_API_KEY=
VITE_DEVICE_ID=unactivated
VITE_SYNC_INTERVAL_MS=15000
VITE_CONSOLE_API_BASE_URL=same-origin

TENANT_URL_TEMPLATE=http://130.210.53.214
TENANT_BASE_DOMAIN=axizpos.com

# Outbound email via Spacemail. SSL on port 465. The mailbox password stays in .env.production.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USERNAME=info@axizpos.com
SMTP_PASSWORD=Ahsan@6684*
SMTP_FROM=info@axizpos.com
SMTP_STARTTLS=false
