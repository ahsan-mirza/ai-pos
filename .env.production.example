# Live server, reached at http://YOUR_VM_PUBLIC_IP until a domain exists.
# Copy to /opt/ai-pos/.env.production on the VM (the API reads the repo root, which is /opt/ai-pos there).
# Selected by APP_ENV=production (`pnpm --filter @ai-pos/api start:prod`, `migrate:prod`).
# The API refuses to start while any value still contains "change-me", CONTROL_DATABASE_URL is unset,
# or DEFAULT_TENANT is set. Generate the secrets with `node scripts/generate-secrets.mjs --env production`.
# Replace every YOUR_VM_PUBLIC_IP below with the Oracle VM's public address (no scheme, no port).
# The filled file is the gitignored .env.production. This example is only the template.

# Template for the tenant databases created by `python -m app.tenancy.cli create`; DATABASE_URL is its server.
DATABASE_URL=postgresql+psycopg://ai_pos:change-me@db.internal:5432/postgres
CONTROL_DATABASE_URL=postgresql+psycopg://ai_pos:change-me@db.internal:5432/qios_control
# TENANT_DATABASE_URL_TEMPLATE=postgresql+psycopg://ai_pos:change-me@db.internal:5432/{database}
# Stores live at https://<store>.axizpos.com. Keep DEFAULT_TENANT unset.
TENANT_BASE_DOMAINS=axizpos.com
TENANT_PUBLIC_URL_TEMPLATE=https://{tenant}.axizpos.com

# Leave signup off until a domain exists. SIGNUP_OTP_CODE, when set in the env file, is the 6-digit code
# signup accepts, and no message is sent.
SIGNUP_ENABLED=false
# SIGNUP_OTP_CODE=
SIGNUP_OTP_CHANNEL=email
SIGNUP_OTP_MINUTES=3
# Signups allowed per email or mobile number per hour.
SIGNUP_MAX_PER_HOUR=5

# Outbound email via Spacemail. SSL on port 465. Paste the mailbox password into SMTP_PASSWORD.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USERNAME=info@axizpos.com
SMTP_PASSWORD=
SMTP_FROM=info@axizpos.com
SMTP_STARTTLS=false

JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
PIN_SALT=change-me-pin-pepper-16+
ENCRYPTION_SECRET=change-me-to-a-different-random-string-32
API_KEY=change-me-api-key
# Registers authenticate with their own activated device token only.
ALLOW_SHARED_API_KEY=false

API_HOST=127.0.0.1
API_PORT=8000
PUBLIC_BASE_URL=https://axizpos.com
# Admin portal. Vite inlines only VITE_ names; signup shows this store suffix.
VITE_TENANT_BASE_DOMAINS=axizpos.com
VITE_TENANT_BASE_DOMAIN=axizpos.com
# Store portals (https://<store>.axizpos.com) are allowed from TENANT_BASE_DOMAINS. List the POS shell
# and the marketing site here.
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:5175,https://axizpos.com
ACCESS_TOKEN_EXPIRE_MINUTES=30
# POS-company console, served from the same IP when you publish it. Set its own secret (never JWT_SECRET's value).
# CONSOLE_JWT_SECRET=
# CONSOLE_ORIGINS=http://YOUR_VM_PUBLIC_IP
# Console Super Admin kept by `python -m app.tenancy.cli init` when email and password are both set.
# CONSOLE_ADMIN_EMAIL=admin@example.com
# CONSOLE_ADMIN_NAME="Ahsan Khalil"
# CONSOLE_ADMIN_PASSWORD=change-me-console-password
# Leave both empty to record go-live payments without Stripe.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SUPPORT_EMAIL=support@axizpos.com
SYNC_MAX_BATCH_SIZE=100
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Super Admin seeded into each new tenant database by the tenancy CLI.
ADMIN_USERNAME=admin
ADMIN_EMAIL=change-me@example.com
ADMIN_FULL_NAME="Super Admin"
ADMIN_PASSWORD=change-me-admin-password
ADMIN_PIN=135790

# Integrated card terminals and buy-now-pay-later. Without credentials a provider falls back to its simulator,
# whose approve/decline buttons only appear for tenants still in practice mode.
CARD_TERMINAL_PROVIDER=ngenius
BNPL_PROVIDERS=tabby,tamara
INTEGRATION_WEBHOOK_SECRET=change-me-integration-webhook-secret
NGENIUS_API_KEY=
NGENIUS_OUTLET_REF=
NGENIUS_BASE_URL=https://api-gateway.ngenius-payments.com
GEIDEA_PUBLIC_KEY=
GEIDEA_API_PASSWORD=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_BASE_URL=https://api.tamara.co
