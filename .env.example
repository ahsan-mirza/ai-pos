# Your machine. Copy to .env at the repo root (bootstrap does this and generates the secrets).
# Every app reads this one file: the API, the admin portal, the register, and the console.
# Selected by APP_ENV=development, the default for `pnpm dev:*`, migrate, and seed.
# URL-encode special characters in the password (for example "@" becomes %40).

DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/ai_pos

# Multi-tenant mode (optional locally). Create the control DB and adopt this database first:
#   python -m app.tenancy.cli init
#   python -m app.tenancy.cli adopt demo --name "Demo" --database ai_pos
# CONTROL_DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/qios_control
# Requests that name no store (plain http://localhost) use this tenant:
# DEFAULT_TENANT=demo
TENANT_BASE_DOMAINS=localhost,qios.ae
TENANT_PUBLIC_URL_TEMPLATE=http://{tenant}.localhost:5173

# Self-service signup at http://localhost:5173/signup (needs CONTROL_DATABASE_URL). With SIGNUP_OTP_CHANNEL=log
# the one-time code is written to the API log and shown on the signup screen.
# SIGNUP_ENABLED=true
# SIGNUP_OTP_CHANNEL=log
# SIGNUP_OTP_MINUTES=10
# SIGNUP_MAX_PER_HOUR=5

JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
PIN_SALT=change-me-pin-pepper-16+
ENCRYPTION_SECRET=change-me-to-a-different-random-string-32
API_KEY=change-me-api-key

API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:1420,tauri://localhost,http://tauri.localhost
ACCESS_TOKEN_EXPIRE_MINUTES=30

# POS-company console (pnpm dev:console). Its own secret, never the same as JWT_SECRET.
# CONSOLE_JWT_SECRET=
# CONSOLE_ORIGINS=http://localhost:5174
# SUPPORT_EMAIL=support@qios.ae
SYNC_MAX_BATCH_SIZE=100
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Super Admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_PIN=135790

# Register (debug builds and the browser preview at http://localhost:1420).
TENANT_URL_TEMPLATE=http://localhost:8000
TENANT_BASE_DOMAIN=localhost
API_BASE_URL=http://localhost:8000
DEVICE_ID=desktop-dev-01
STORE_ID=00000000-0000-4000-8000-000000000001

# Admin portal (http://localhost:5173). Vite only inlines VITE_ names.
VITE_API_BASE_URL=http://localhost:8000
VITE_DEFAULT_CURRENCY=USD
VITE_TENANT_BASE_DOMAINS=localhost
VITE_DEFAULT_TENANT=demo
VITE_SHOW_DEMO_ACCOUNTS=false
VITE_DEMO_ADMIN_USERNAME=admin
VITE_DEMO_ADMIN_PASSWORD=

# Register browser preview.
VITE_STORE_ID=00000000-0000-4000-8000-000000000001
VITE_API_KEY=change-me-api-key
VITE_DEVICE_ID=desktop-dev-01
VITE_TENANT_BASE_DOMAIN=localhost
VITE_SYNC_INTERVAL_MS=15000

# Operator console (http://localhost:5174).
VITE_CONSOLE_API_BASE_URL=http://localhost:8000
